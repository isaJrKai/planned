# Database — PostgreSQL (Neon)
# Get a database at https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Dedicated encryption secret. Required in production; use a random value of 32+ chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-with-a-long-random-secret

# Optional separate database for integration tests.
# TEST_DATABASE_URL=postgresql://user:password@host/test_database?sslmode=require

# Canonical founder email. Pre-fills /setup form.
FOUNDER_EMAIL=founder@example.com

# Set to "true" in production to disable the founder:recover script.
DISABLE_FOUNDER_RECOVERY=false
